.container {
  width: min(100% - 32px, var(--container-width));
  margin-inline: auto;
}

@media (max-width: 768px) {
  .container {
    width: min(100% - 24px, var(--container-width));
  }
}
@media (max-width: 900px) {
  .navbar-links {
    display: none;
  }

  .navbar-links.open {
    position: absolute;
    top: 80px;
    left: 4%;
    right: 4%;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    background: var(--forest-dark);

    padding: 25px;

    border-radius: 18px;
  }

  .navbar-menu {
    display: block;
  }

  .navbar-login,
  .navbar-signup {
    display: none;
  }

  .travel-hero h1 {
    font-size: clamp(3.5rem, 15vw, 6rem);
  }

  .hero-bottom {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-actions {
    flex-wrap: wrap;
  }

  .destination-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .destination-showcase-grid {
    grid-template-columns: 1fr;
  }

  .showcase-card,
  .showcase-card-featured {
    height: 500px;
  }

  .hero-scroll-indicator {
    display: none;
  }
}