/* Keep homepage navigation visible throughout the scroll. */
.navbar.navbar--nature {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  transition: background-color 200ms ease, border-color 200ms ease;
}

.navbar.navbar--nature.navbar--scrolled {
  background: var(--journey-forest);
  border-bottom: 1px solid var(--journey-line);
}

.navbar--scrolled .logo,
.navbar--scrolled .nav-links a,
.navbar--scrolled .login-link {
  text-shadow: none;
}

@media (prefers-reduced-motion: reduce) {
  .navbar.navbar--nature {
    transition: none;
  }
}

@media (max-width: 900px) {
  .navbar--nature .nav-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
  }

  .navbar--nature .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .navbar--nature .nav-actions .login-link {
    display: inline-block;
    font-size: 18px;
  }

  .navbar--nature .logo {
    font-size: 19px;
  }

  .navbar--nature .small-btn {
    font-size: 18px;
    padding: 10px 20px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .navbar--nature .nav-links {
    display: flex;
    order: 0;
    width: auto;
    gap: 20px;
    flex-wrap: nowrap;
    font-size: 15px;
    white-space: nowrap;
  }
}

.destination-card-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.destination-detail-image {
  width: 350px;
  height: 350px;
  object-fit: cover;
  border-radius: 24px;
}
@media (max-width: 600px) {
  .navbar--nature .nav-inner {
    min-height: 100px;
    padding-block: 14px;
  }

  .navbar--nature .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
  }

  .navbar--nature .nav-actions .login-link {
    display: inline-block;
    font-size: 18px;
  }

  .navbar--nature .logo {
    font-size: 19px;
  }

  .navbar--nature .small-btn {
    font-size: 14px;
    padding: 8px 18px;
    border-radius: 8px;
    white-space: nowrap;
  }

  .home .morph__hero-text {
    padding: 136px 20px 56px;
  }

