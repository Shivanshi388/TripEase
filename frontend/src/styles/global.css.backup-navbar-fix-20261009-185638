/* =========================
   TRIPEASE COLOR SYSTEM
========================= */

:root {
  --forest: #173c2b;
  --forest-dark: #0d261b;
  --leaf: #497a56;
  --sage: #9db59c;
  --cream: #f5f0e6;
  --sand: #d6c4a2;
  --warm-white: #fffdf8;
  --charcoal: #20241f;
  --muted: #6e756d;
}

/* =========================
   GLOBAL
========================= */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Inter, Arial, sans-serif;
  background: var(--warm-white);
  color: var(--charcoal);
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

/* Layout */

.container {
  width: min(92%, 1300px);
  margin: 0 auto;
}

/* =========================
   NAVBAR
========================= */

.navbar {
  height: 80px;
  display: flex;
  align-items: center;
  background: var(--warm-white);
  color: var(--charcoal);
  position: relative;
  z-index: 100;
}

.navbar-overlay {
  position: absolute;
  width: 100%;
  top: 0;
  left: 0;
  background: transparent;
  color: white;
}

.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
  font-size: 1.35rem;
}

.navbar-logo > span:last-child > span {
  color: #b9d5a9;
}

.navbar-logo-icon {
  display: flex;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.navbar-links a {
  display: flex;
  align-items: center;
  gap: 5px;
  font-weight: 500;
  font-size: 0.95rem;
  transition: opacity 0.2s ease;
}

.navbar-links a:hover {
  opacity: 0.7;
}

.navbar-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}

.navbar-login {
  font-weight: 500;
}

.navbar-signup {
  background: var(--cream);
  color: var(--forest-dark);
  padding: 12px 18px;
  border-radius: 999px;
  font-weight: 600;
}

.navbar-menu {
  background: none;
  border: none;
  color: inherit;
  display: none;
}

/* =========================
   HERO
========================= */

.travel-hero {
  min-height: 100vh;
  position: relative;

  background-size: cover;
  background-position: center;

  display: flex;
  align-items: flex-end;

  color: white;

  overflow: hidden;
}

.hero-overlay {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      90deg,
      rgba(7, 31, 21, 0.72) 0%,
      rgba(7, 31, 21, 0.3) 48%,
      rgba(7, 31, 21, 0.08) 100%
    ),
    linear-gradient(
      0deg,
      rgba(5, 23, 16, 0.7) 0%,
      transparent 55%
    );
}

.travel-hero-content {
  position: relative;
  z-index: 2;

  padding-bottom: 100px;
}

.hero-location {
  display: inline-flex;
  align-items: center;
  gap: 8px;

  margin-bottom: 22px;

  font-size: 0.95rem;
  font-weight: 500;
}

.travel-hero h1 {
  font-size: clamp(4.2rem, 8vw, 8.4rem);
  line-height: 0.88;

  letter-spacing: -0.065em;

  max-width: 1100px;

  font-weight: 650;
}

.travel-hero h1 span {
  color: #d9e5c7;
}

.hero-bottom {
  margin-top: 55px;

  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  gap: 50px;
}

.hero-bottom > div:first-child {
  max-width: 500px;
}

.hero-tagline {
  font-size: 1.45rem;
  font-weight: 600;

  margin-bottom: 10px;
}

.hero-description {
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;

  max-width: 480px;
}

.hero-actions {
  display: flex;
  gap: 12px;
}

.hero-primary-btn,
.hero-secondary-btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;

  padding: 15px 23px;

  border-radius: 999px;

  font-weight: 600;
}

.hero-primary-btn {
  background: var(--cream);
  color: var(--forest-dark);
}

.hero-secondary-btn {
  border: 1px solid rgba(255, 255, 255, 0.55);
  color: white;

  backdrop-filter: blur(6px);
}

.hero-scroll-indicator {
  position: absolute;
  z-index: 3;

  right: 4%;
  bottom: 75px;

  display: flex;
  align-items: center;
  gap: 14px;

  font-size: 0.8rem;
}

.scroll-line {
  width: 60px;
  height: 1px;

  background: rgba(255, 255, 255, 0.6);
}

/* =========================
   DESTINATION SHOWCASE
========================= */

.destination-showcase {
  background: var(--cream);

  padding: 130px 0 120px;

  position: relative;
  z-index: 5;
}

.destination-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  gap: 50px;

  margin-bottom: 65px;
}

.section-label {
  display: inline-block;

  color: var(--leaf);

  font-weight: 700;
  font-size: 0.78rem;

  letter-spacing: 0.16em;

  margin-bottom: 18px;
}

.destination-heading h2 {
  font-size: clamp(3rem, 5vw, 5.7rem);
  line-height: 0.95;

  letter-spacing: -0.05em;

  font-weight: 600;
}

.destination-heading h2 span {
  color: var(--leaf);
}

.destination-heading > p {
  max-width: 390px;

  color: var(--muted);

  font-size: 1.05rem;
  line-height: 1.6;
}

.destination-showcase-grid {
  display: grid;

  grid-template-columns: 1.25fr 1fr 1fr;

  gap: 18px;

  align-items: end;
}

.showcase-card {
  height: 520px;

  position: relative;

  border-radius: 26px;

  overflow: hidden;

  color: white;
}

.showcase-card-featured {
  height: 620px;

  /*
    The same photograph as the hero appears here.
    This gives the "hero transforms into a card" feeling.
  */
}

.showcase-card img {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform 0.7s ease;
}

.showcase-card:hover img {
  transform: scale(1.04);
}

.showcase-card-gradient {
  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      to top,
      rgba(4, 23, 16, 0.75),
      transparent 55%
    );
}

.showcase-card-content {
  position: absolute;

  left: 28px;
  bottom: 28px;

  z-index: 2;
}

.showcase-location {
  display: flex;
  align-items: center;
  gap: 6px;

  font-size: 0.82rem;

  margin-bottom: 8px;

  opacity: 0.85;
}

.showcase-card h3 {
  font-size: 2rem;
  margin-bottom: 5px;
}

.showcase-card p {
  font-size: 0.93rem;
  opacity: 0.8;
}

.showcase-arrow {
  position: absolute;

  z-index: 3;

  top: 20px;
  right: 20px;

  width: 46px;
  height: 46px;

  background: rgba(255, 255, 255, 0.9);

  color: var(--forest-dark);

  display: flex;
  justify-content: center;
  align-items: center;

  border-radius: 50%;
}

.destination-footer-link {
  margin-top: 35px;

  display: flex;
  justify-content: flex-end;
}

.destination-footer-link a {
  display: flex;
  align-items: center;
  gap: 7px;

  font-weight: 600;
  color: var(--forest);
}
/* Full-screen homepage navigation + refreshed footer */
:root {
  --journey-paper: oklch(0.98 0.014 105);
  --journey-forest: oklch(0.27 0.045 153);
  --journey-leaf: oklch(0.84 0.09 128);
  --journey-muted: oklch(0.77 0.025 145);
  --journey-line: oklch(0.98 0.014 105 / 18%);
  --journey-hover: oklch(0.98 0.014 105 / 12%);
  --journey-photo-shade: oklch(0.16 0.025 153 / 65%);
}

/* The navbar no longer pushes the homepage down. */
.navbar.navbar--nature {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 100;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
}

.navbar--nature .nav-inner {
  min-height: 88px;
  height: 100px;
  padding-block: 18px;
  gap: 24px;
}

.navbar--nature .logo,
.navbar--nature .nav-links a,
.navbar--nature .login-link {
  color: var(--journey-paper);
  text-shadow: 0 2px 10px var(--journey-photo-shade);
}

.navbar--nature .nav-links a:hover,
.navbar--nature .login-link:hover {
  color: var(--journey-leaf);
}

.navbar--nature .btn-primary {
  background: var(--journey-paper);
  color: var(--journey-forest);
  border-radius: 6px;
  text-shadow: none;
}

.navbar--nature .btn-primary:hover {
  background: var(--journey-leaf);
}

.app-main--home,
.app-main--home > .home {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
}

/* Keep the photo stage as tall as the visible screen. */
.home .morph {
  height: 300vh;
  height: 300svh;
  margin: 0;
  padding: 0;
}

.home .morph__sticky {
  top: 0;
  height: 100vh;
  height: 100svh;
  width: 100%;
}

.home .morph__photo img {
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  display: block;
}

.home .morph__hero-text {
  box-sizing: border-box;
  padding: 112px 24px 72px;
}

