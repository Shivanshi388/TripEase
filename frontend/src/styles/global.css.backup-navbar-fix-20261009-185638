.explore-header {
  padding-top: 130px;
  margin-bottom: 40px;
  text-align: center;
}

.explore-header h1 {
  font-size: 3rem;
  margin-bottom: 24px;
  color: #24502f;
}

.destination-filters {
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

.destination-filters input,
.destination-filters select {
  padding: 14px 18px;
  border: 1px solid #ddd;
  border-radius: 999px;
  font-size: 1rem;
}

.destination-filters input {
  width: 320px;
}


.no-results {
  text-align: center;
  font-size: 1.1rem;
  color: #666;
  grid-column: 1 / -1;
}

.destination-card img {
  width: 100%;
  height: 240px;      /* same height for every image */
  object-fit: cover;  /* crops instead of stretching */
  display: block;
  border-radius: 20px; /* all 4 corners rounded */
  margin-bottom: 12px;
}

.destination-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  align-items: stretch;
}

.destination-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden !important;
  border-radius: 20px !important;
  background: white;
  padding: 12px;
  cursor: pointer;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.destination-card:hover {
  transform: translateY(-4px);
}

.destination-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 16px;
  background: transparent;
  gap: 12px;
}

.destination-content h3 {
  margin-bottom: 8px;
  min-height: 32px;
}

.destination-content p {
  flex: 1;
  margin-bottom: 16px;
  color: #666;
  line-height:1.5;
}

.destination-content .btn {
  margin-top: auto;
}

.destination-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  width: 100%;
}

.destination-header h3 {
  margin: 0;
}

.wishlist-btn {
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wishlist-btn svg {
  transition: all 0.2s ease;
}

.wishlist-btn:hover svg {
  transform: scale(1.15);
}